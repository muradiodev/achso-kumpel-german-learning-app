{
  "name": "achso-kumpel",
  "version": "0.2.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.14",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.7",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-speech": "~58.0.3",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "check:content": "node scripts/check-content.mjs",
    "build:apk": "node scripts/write-version.mjs && npx eas-cli@latest build -p android --profile preview",
    "version:write": "node scripts/write-version.mjs",
    "build:web": "node scripts/write-version.mjs && expo export --platform web",
    "deploy:web": "npm run build:web && npx eas-cli@latest deploy --prod"
  },

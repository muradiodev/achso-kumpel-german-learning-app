  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "check:content": "node scripts/check-content.mjs",
    "build:apk": "node scripts/write-version.mjs && npx eas-cli@latest build -p android --profile preview",

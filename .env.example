# Copy to .env. Public values only: anything EXPO_PUBLIC_ ends up in the app bundle.

# Release manifest the Android/iOS app polls for new versions.
# Point it at the deployed web app, which serves /version.json.
EXPO_PUBLIC_VERSION_URL=https://your-domain.example/version.json

# AchsoKumpel API for accounts and progress sync. Leave unset for device-only accounts.
# EXPO_PUBLIC_API_URL=https://achsokumpelapi.deviofy.com

{
  "expo": {
    "name": "AchsoKumpel",
    "slug": "achso-kumpel",
    "scheme": "achsokumpel",
    "version": "0.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.achsokumpel.app"
    },
    "android": {
      "package": "io.achsokumpel.app",
      "adaptiveIcon": {
        "backgroundColor": "#6E3BE0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "AchsoKumpel",
      "shortName": "AchsoKumpel",
      "description": "Dein Kumpel fürs Deutschlernen. Free practice app for real German at work and in daily life.",
      "lang": "en",
      "themeColor": "#6E3BE0",
      "backgroundColor": "#FAF9FC",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FAF9FC",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0E0C14"
          }
        }
      ]
    ],
    "extra": {
      "minSupportedVersion": "0.1.0",
      "apkUrl": ""
    },
    "experiments": {
      "baseUrl": "/app"
    }
  }
}
